# Runtime environment: development | test | production
NODE_ENV=development
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Path to the facilities data file
DATA_PATH=assets/facilities.json
# Comma-separated list of allowed CORS origins (empty = none)
CORS_ORIGINS=http://localhost:5173
# Requests per minute per authenticated user (IP fallback)
RATE_LIMIT_PER_MINUTE=120
# Delay after /ready flips to 503 before closing the server (0 in dev, ~5000 in prod)
SHUTDOWN_DELAY_MS=0
# Force-exit if graceful shutdown takes longer than this
SHUTDOWN_TIMEOUT_MS=10000
# Upper bound on how long a verified token is cached
TOKEN_CACHE_TTL_MS=60000
